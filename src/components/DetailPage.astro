---
/**
 * Layout for one company or one person: a dark header with a large Light
 * title, a row of facts, the body text and a large link to the next entry.
 * Used by src/pages/portfolio/[slug].astro and src/pages/team/[slug].astro.
 */
interface Fact {
	label: string;
	value: string;
}

interface Props {
	back: { href: string; label: string };
	label?: string | null;
	title: string;
	lead?: string | null;
	facts?: Fact[];
	next?: { href: string; title: string; label: string } | null;
	mediaKind?: "logo" | "photo";
}

const { back, label, title, lead, facts = [], next, mediaKind = "logo" } = Astro.props;
const hasMedia = Astro.slots.has("media");
---

<section class="dt-head tone-dark" data-tone="dark">
	<div class="sc-container dt-head__inner" class:list={{ "has-media": hasMedia }}>
		<div class="dt-head__text">
			<a href={back.href} class="dt-back sc-label">
				<span aria-hidden="true">←</span>
				{back.label}
			</a>
			{label && <p class="sc-label sc-label--rule dt-head__label">{label}</p>}
			<h1 class="sc-display dt-head__title">{title}</h1>
			{lead && <p class="sc-lead dt-head__lead">{lead}</p>}
		</div>
		{
			hasMedia && (
				<div class:list={["dt-head__media", `dt-head__media--${mediaKind}`]}>
					<slot name="media" />
				</div>
			)
		}
	</div>
</section>

<section class="dt-body tone-light" data-tone="light">
	<div class="sc-container">
		{
			facts.length > 0 && (
				<dl class="dt-facts">
					{facts.map((f) => (
						<div>
							<dt class="sc-label">{f.label}</dt>
							<dd>{f.value}</dd>
						</div>
					))}
				</dl>
			)
		}
		<div class="dt-body__main">
			<slot />
		</div>
	</div>
</section>

{
	next && (
		<section class="dt-next tone-light" data-tone="light">
			<div class="sc-container">
				<a href={next.href} class="dt-next__link">
					<span class="sc-label">{next.label}</span>
					<span class="dt-next__title">
						{next.title}
						<span class="dt-next__arrow" aria-hidden="true">
							→
						</span>
					</span>
				</a>
			</div>
		</section>
	)
}

<style>
	.dt-head {
		padding-block: calc(var(--sc-header-h) + clamp(48px, 7vw, 112px)) clamp(56px, 7vw, 104px);
	}

	.dt-head__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(40px, 5vw, 80px);
		align-items: end;
	}

	.dt-head__inner.has-media {
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
	}

	.dt-head__text {
		display: grid;
		gap: clamp(20px, 2.4vw, 32px);
		justify-items: start;
	}

	.dt-back {
		display: inline-flex;
		gap: 10px;
		color: var(--sc-mid-grey);
		text-decoration: none;
		margin-block-end: clamp(16px, 3vw, 40px);
		transition: color 0.3s;
	}

	.dt-back:hover {
		color: var(--sc-white);
	}

	.dt-head__label {
		color: var(--sc-mid-grey);
	}

	.dt-head__title {
		max-width: 14ch;
		font-size: clamp(48px, 8vw, 136px);
		line-height: 1;
		animation: dt-in 1.1s var(--sc-ease) both;
	}

	.dt-head__lead {
		max-width: 44ch;
		color: var(--sc-mid-grey);
	}

	.dt-head__media {
		overflow: hidden;
	}

	.dt-head__media--logo {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		background: var(--sc-white);
		padding: 12%;
	}

	.dt-head__media--logo :global(img) {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.dt-head__media--photo {
		aspect-ratio: 4 / 5;
	}

	.dt-head__media--photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
	}

	.dt-body {
		padding-block: clamp(56px, 7vw, 104px);
	}

	.dt-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 32px 24px;
		padding-block-end: clamp(40px, 5vw, 72px);
		margin-block-end: clamp(40px, 5vw, 72px);
		border-block-end: 1px solid var(--sc-line);
	}

	.dt-facts div {
		display: grid;
		gap: 10px;
		align-content: start;
	}

	.dt-facts dt {
		color: var(--sc-muted, var(--sc-grey));
	}

	.dt-facts dd {
		font-size: clamp(18px, 1.5vw, 22px);
		line-height: 1.35;
	}

	.dt-body__main {
		max-width: 68ch;
	}

	.dt-next {
		padding-block: 0 clamp(96px, 12vw, 160px);
	}

	.dt-next__link {
		display: grid;
		gap: 16px;
		padding-block: clamp(32px, 4vw, 56px);
		border-block-start: 1px solid var(--sc-line);
		color: inherit;
		text-decoration: none;
	}

	.dt-next__link .sc-label {
		color: var(--sc-muted, var(--sc-grey));
	}

	.dt-next__title {
		display: flex;
		align-items: baseline;
		gap: 0.4em;
		font-size: clamp(40px, 6vw, 96px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.dt-next__arrow {
		color: var(--sc-light-green);
		transition: transform 0.5s var(--sc-ease);
	}

	.dt-next__link:hover .dt-next__arrow,
	.dt-next__link:focus-visible .dt-next__arrow {
		transform: translateX(0.25em);
	}

	@keyframes dt-in {
		from {
			opacity: 0.001;
			transform: translateY(0.12em);
		}
	}

	@media (max-width: 860px) {
		.dt-head__inner.has-media {
			grid-template-columns: minmax(0, 1fr);
		}

		.dt-head__media--photo {
			max-width: 420px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dt-head__title {
			animation: none;
		}
	}
</style>

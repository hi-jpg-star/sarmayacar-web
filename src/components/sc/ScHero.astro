---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { fileUrl, href, isExternal, words } from "../../utils/sc";
import GlassInsignia from "./GlassInsignia.astro";

type Block = Extract<PageContentBlock, { _type: "sc_hero" }>;
type Props = BlockComponentProps<Block>;

const { value, index } = Astro.props;
const { headline, eyebrow, subheadline, cta_label, cta_url, video, image, anchor_id } = value;
const layout = (value as { layout?: string | null }).layout;
const isHome = layout === "home" && index === 0;
const videoSrc = isHome ? undefined : fileUrl(video as never, Astro.locals as never);
const cta = cta_label ? href(cta_url) : undefined;
const w = words(headline);
---

{isHome && <GlassInsignia />}

<section
	class:list={["hero tone-dark", { "hero--home": isHome }]}
	data-tone="dark"
	data-glass-stage={isHome ? "" : undefined}
	id={anchor_id || undefined}
>
	<div class="hero__head sc-container">
		{eyebrow && <p class="sc-label sc-label--rule hero__eyebrow" data-reveal>{eyebrow}</p>}
		<h1 class="sc-display hero__title" aria-label={headline}>
			{
				w.map((word, i) => (
					<span class="sc-line hero__word" style={`--line-i:${i}; --line-delay:${isHome ? 500 : 150}ms`} aria-hidden="true">
						<span>{word}</span>
					</span>
				))
			}
		</h1>
		{
			(subheadline || cta) && (
				<div class="hero__aside" data-reveal style="--reveal-i:3">
					{subheadline && <p class="sc-lead hero__sub">{subheadline}</p>}
					{cta && (
						<a href={cta} class="sc-btn" target={isExternal(cta) ? "_blank" : undefined} rel="noopener">
							{cta_label}
							<span class="sc-btn__arrow" />
						</a>
					)}
				</div>
			)
		}
	</div>

	{
		!isHome && (videoSrc || image) && (
			<div class="hero__media" data-hero-media>
				<div class="hero__frame">
					{videoSrc ? (
						<video src={videoSrc} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
					) : (
						image && <Image image={image} sizes="100vw" loading={index === 0 ? "eager" : "lazy"} />
					)}
				</div>
			</div>
		)
	}

	{isHome && <p class="hero__scroll sc-label" aria-hidden="true">Scroll<span /></p>}
</section>

<script>
	// Headline words rise in on load.
	requestAnimationFrame(() => {
		document.querySelectorAll(".hero__title").forEach((t) => t.classList.add("is-in"));
	});

	// Media frame widens to full bleed as it scrolls up (standard pages).
	const frames = document.querySelectorAll<HTMLElement>("[data-hero-media]");
	if (frames.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const tick = () => {
			const vh = innerHeight;
			for (const el of frames) {
				const r = el.getBoundingClientRect();
				const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
				el.style.setProperty("--p", p.toFixed(3));
			}
		};
		addEventListener("scroll", tick, { passive: true });
		addEventListener("resize", tick);
		tick();
	}

</script>

<style>
	.hero {
		position: relative;
		padding-block: calc(var(--sc-header-h) + clamp(72px, 10vw, 150px)) clamp(64px, 8vw, 120px);
		overflow: hidden;
	}

	/* Home: transparent so the glass scene shows; full screen; logo on top, text at the bottom */
	.hero--home {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 100svh;
		padding-block: calc(var(--sc-header-h) + 8px) clamp(40px, 5vw, 72px);
		background: transparent;
		overflow: visible;
	}

	.hero__head {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(28px, 4vw, 48px);
	}

	.hero__title {
		max-width: 14ch;
	}

	.hero--home .hero__head {
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: end;
		gap: 24px clamp(32px, 5vw, 96px);
	}

	.hero--home .hero__eyebrow {
		grid-column: 1 / -1;
		color: var(--sc-mid-grey);
	}

	.hero--home .hero__title {
		font-size: clamp(44px, 6.4vw, 112px);
		max-width: 11ch;
	}

	.hero--home .hero__aside {
		border: 0;
		padding: 0;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero__word {
		display: inline-block;
		margin-inline-end: 0.22em;
	}

	.hero__aside {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		padding-block-start: clamp(16px, 3vw, 40px);
		border-block-start: 1px solid var(--sc-line-on-dark);
	}

	.hero__sub {
		color: var(--sc-mid-grey);
	}

	.hero__media {
		--p: 0;
		margin-block-start: clamp(56px, 7vw, 104px);
	}

	.hero__frame {
		position: relative;
		aspect-ratio: 16 / 8;
		overflow: hidden;
		margin-inline: auto;
		width: calc(100% - (1 - var(--p)) * (var(--sc-gutter) * 2 + max(0px, (100vw - var(--sc-max)))));
		max-height: 92svh;
	}

	.hero__frame video,
	.hero__frame :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(calc(1.12 - var(--p) * 0.12));
	}

	.hero__scroll {
		position: absolute;
		inset-inline-end: var(--sc-gutter);
		inset-block-end: clamp(40px, 5vw, 72px);
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--sc-mid-grey);
		writing-mode: vertical-rl;
	}

	.hero__scroll span {
		position: relative;
		width: 1px;
		height: 56px;
		overflow: hidden;
		background: var(--sc-line-on-dark);
	}

	.hero__scroll span::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		height: 40%;
		background: var(--sc-light-green);
		animation: scroll-cue 2.2s var(--sc-ease-in-out) infinite;
	}

	@keyframes scroll-cue {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(250%);
		}
	}

	@media (max-width: 860px) {
		.hero--home .hero__head {
			grid-template-columns: 1fr;
		}

		.hero__scroll {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.hero__frame {
			aspect-ratio: 4 / 5;
		}
	}

</style>

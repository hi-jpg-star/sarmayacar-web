---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import insignia from "../../assets/brand/insignia.svg?url";
import { href } from "../../utils/sc";

type Block = Extract<PageContentBlock, { _type: "sc_statement" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
const link = href(value.link_url);
---

<section class="st tone-light" data-tone="light" id={value.anchor_id || undefined}>
	<div class="sc-container">
		<div class="st__line" data-reveal>
			<span class="sc-label">{value.left_label}</span>
			<i aria-hidden="true"></i>
			<img src={insignia} alt="" width="48" height="48" />
			<i aria-hidden="true"></i>
			<span class="sc-label">{value.right_label}</span>
		</div>
		<h2 class="sc-h2 st__title" data-reveal style="--reveal-i:1">{value.headline}</h2>
		{
			link && value.link_label && (
				<p class="st__link" data-reveal style="--reveal-i:2">
					<a href={link} class="sc-link">
						{value.link_label}
					</a>
				</p>
			)
		}
	</div>
</section>

<style>
	.st {
		padding-block: clamp(96px, 12vw, 160px);
		text-align: center;
	}

	.st__line {
		display: grid;
		grid-template-columns: auto 1fr auto 1fr auto;
		align-items: center;
		gap: 20px;
		margin-block-end: clamp(40px, 5vw, 72px);
		color: var(--sc-muted, var(--sc-grey));
	}

	.st__line i {
		height: 1px;
		background: var(--sc-line);
	}

	.st__title {
		max-width: 20ch;
		margin-inline: auto;
	}

	.st__link {
		margin-block-start: 32px;
	}
</style>

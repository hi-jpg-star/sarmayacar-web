---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type Block = Extract<PageContentBlock, { _type: "sc_text" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
const [first, ...rest] = toParagraphs(value.body);
---

<section class="tx tone-light" data-tone="light" id={value.anchor_id || undefined}>
	<div class="sc-container tx__grid">
		{value.headline && <h2 class="sc-label sc-label--rule tx__label" data-reveal>{value.headline}</h2>}
		{first && <p class="tx__lead" data-reveal>{first}</p>}
		{
			rest.length > 0 && (
				<div class="tx__rest" data-reveal style="--reveal-i:1">
					{rest.map((p) => (
						<p>{p}</p>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.tx {
		padding-block: clamp(96px, 12vw, 160px);
	}

	.tx__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
		gap: 32px clamp(32px, 4vw, 64px);
	}

	.tx__label {
		grid-column: 1;
		color: var(--sc-muted, var(--sc-grey));
		padding-block-start: 0.7em;
	}

	.tx__lead {
		grid-column: 2;
		font-size: clamp(22px, 2.4vw, 34px);
		font-weight: 300;
		line-height: 1.3;
		letter-spacing: -0.015em;
	}

	.tx__rest {
		grid-column: 3;
		display: grid;
		gap: 1em;
		font-size: 16px;
		line-height: 1.7;
		color: var(--sc-muted, var(--sc-grey));
		align-self: end;
	}

	@media (max-width: 900px) {
		.tx__grid {
			grid-template-columns: 1fr;
		}

		.tx__label,
		.tx__lead,
		.tx__rest {
			grid-column: 1;
		}
	}
</style>

---
/**
 * Frosted-glass 3D Sarmayacar insignia (three.js), fixed behind the top of the
 * home page. Its two interlocking parts float, follow the pointer slightly,
 * and separate and leave the frame as the visitor scrolls.
 *
 * The canvas is transparent and sits in front of the page (pointer-events
 * off). The glass refracts a painted copy of the text behind it, with a
 * slight colour split at the edges, so it reads as thick, clear glass.
 * Without WebGL or with reduced motion, a still insignia image is shown.
 */
import insigniaRaw from "../../assets/brand/insignia.svg?raw";
import insigniaUrl from "../../assets/brand/insignia.svg?url";
---

<div class="glass" aria-hidden="true" data-glass>
	<canvas class="glass__canvas"></canvas>
	<img class="glass__fallback" src={insigniaUrl} alt="" width="280" height="280" />
	<template data-svg set:html={insigniaRaw} />
</div>

<script>
	import type { Group as GroupT } from "three";
	const root = document.querySelector<HTMLElement>("[data-glass]");
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

	function webglOk() {
		try {
			const c = document.createElement("canvas");
			return !!(c.getContext("webgl2") || c.getContext("webgl"));
		} catch {
			return false;
		}
	}

	// Software WebGL (no graphics card: some low-end devices, headless browsers)
	// is far too slow for this scene; those visitors get the still insignia.
	function hardwareGl() {
		try {
			const gl = document.createElement("canvas").getContext("webgl");
			const info = gl?.getExtension("WEBGL_debug_renderer_info");
			const name = info ? String(gl!.getParameter(info.UNMASKED_RENDERER_WEBGL)) : "";
			return !/swiftshader|llvmpipe|software|basic render/i.test(name);
		} catch {
			return false;
		}
	}

	const start = async () => {
		if (!root || reduce || !webglOk() || !hardwareGl()) return;
		const {
			Color,
			ExtrudeGeometry,
			Group,
			Mesh,
			ShaderMaterial,
			PerspectiveCamera,
			Scene,
			SRGBColorSpace,
			WebGLRenderer,
			Box3,
			Vector2,
			Vector3,
			CanvasTexture,
			LinearFilter,
			FrontSide,
		} = await import("three");
		const { SVGLoader } = await import("three/examples/jsm/loaders/SVGLoader.js");

		const css = getComputedStyle(document.documentElement);
		const cssColor = (name: string) => css.getPropertyValue(name).trim();
		const darkGreen = new Color(cssColor("--sc-dark-green"));
		// The shader works in display (sRGB) values, so pass the brand colours raw.
		const raw = (name: string) => {
			const c = new Color(cssColor(name));
			const out = { r: 0, g: 0, b: 0 };
			c.getRGB(out, SRGBColorSpace);
			return new Vector3(out.r, out.g, out.b);
		};

		const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
		const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
		const mobile = matchMedia("(max-width: 760px)").matches;
		renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.5 : 1.75));
		renderer.outputColorSpace = SRGBColorSpace;
		renderer.setClearColor(darkGreen, 0); // transparent: the page shows through

		const scene = new Scene();

		const camera = new PerspectiveCamera(30, 1, 1, 5000);
		camera.position.set(0, 0, 1100);

		// Extrude the two insignia shapes from the real logo file.
		const tpl = root.querySelector<HTMLTemplateElement>("template[data-svg]")!;
		const svg = new SVGLoader().parse(tpl.innerHTML);
		// ---- What is behind the glass ----------------------------------------
		// The glass can only bend what WebGL can see, so the visible text of the
		// stage sections (hero, manifesto) is painted into an offscreen canvas at
		// its exact on-screen position. The page itself is never replaced: the
		// glass shows a bent, colour-split copy of it, like real thick glass.
		const bg = document.createElement("canvas");
		const ctx = bg.getContext("2d")!;
		const bgTex = new CanvasTexture(bg);
		bgTex.minFilter = LinearFilter;
		bgTex.magFilter = LinearFilter;
		bgTex.generateMipmaps = false;
		const pageBg = cssColor("--sc-dark-green");

		type Word = { node: Text; start: number; end: number; text: string; el: HTMLElement; stop: HTMLElement };
		let wordList: Word[] = [];
		const collect = () => {
			wordList = [];
			document.querySelectorAll<HTMLElement>("[data-glass-stage]").forEach((stage) => {
				const walker = document.createTreeWalker(stage, NodeFilter.SHOW_TEXT);
				let n: Node | null;
				while ((n = walker.nextNode())) {
					const node = n as Text;
					const el = node.parentElement;
					if (!el || el.closest(".sc-sr-only, .intro, template, script, style")) continue;
					for (const m of node.data.matchAll(/\S+/g)) {
						wordList.push({ node, start: m.index!, end: m.index! + m[0].length, text: m[0], el, stop: stage });
					}
				}
			});
		};
		const range = document.createRange();
		const opacityOf = (el: HTMLElement, stop: HTMLElement) => {
			let o = 1;
			for (let e: HTMLElement | null = el; e && e !== stop.parentElement; e = e.parentElement) {
				o *= parseFloat(getComputedStyle(e).opacity || "1");
				if (o <= 0.01) break;
			}
			return o;
		};
		const paint = () => {
			const vw = innerWidth, vh = innerHeight;
			if (bg.width !== vw || bg.height !== vh) {
				bg.width = vw;
				bg.height = vh;
			}
			ctx.globalAlpha = 1;
			ctx.fillStyle = pageBg;
			ctx.fillRect(0, 0, vw, vh);
			// solid boxes such as the hero button
			document.querySelectorAll<HTMLElement>("[data-glass-stage] .sc-btn").forEach((btn) => {
				const r = btn.getBoundingClientRect();
				if (r.bottom < 0 || r.top > vh) return;
				ctx.fillStyle = getComputedStyle(btn).backgroundColor;
				ctx.fillRect(r.left, r.top, r.width, r.height);
			});
			ctx.textBaseline = "alphabetic";
			let lastEl: HTMLElement | null = null;
			let style: CSSStyleDeclaration | null = null;
			let ascent = 0;
			for (const w of wordList) {
				range.setStart(w.node, w.start);
				range.setEnd(w.node, w.end);
				const r = range.getBoundingClientRect();
				if (r.bottom < 0 || r.top > vh || r.width === 0) continue;
				if (w.el !== lastEl) {
					lastEl = w.el;
					style = getComputedStyle(w.el);
					ctx.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
					(ctx as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing =
						style.letterSpacing === "normal" ? "0px" : style.letterSpacing;
					ctx.fillStyle = style.color;
					ctx.globalAlpha = opacityOf(w.el, w.stop);
					ascent = ctx.measureText("Hg").fontBoundingBoxAscent;
				}
				const text = style!.textTransform === "uppercase" ? w.text.toUpperCase() : w.text;
				ctx.fillText(text, r.left, r.top + ascent);
			}
			bgTex.needsUpdate = true;
		};
		collect();

		const material = new ShaderMaterial({
			side: FrontSide,
			uniforms: {
				uBg: { value: bgTex },
				uRes: { value: new Vector2(1, 1) },
				uCentre: { value: new Vector2(0.5, 0.5) },
				uTint: { value: raw("--sc-light-green") },
				uWhite: { value: raw("--sc-white") },
			},
			vertexShader: `
				varying vec3 vN;
				varying vec3 vV;
				void main() {
					vec4 mv = modelViewMatrix * vec4(position, 1.0);
					vN = normalize(normalMatrix * normal);
					vV = normalize(-mv.xyz);
					gl_Position = projectionMatrix * mv;
				}`,
			fragmentShader: `
				uniform sampler2D uBg;
				uniform vec2 uRes;
				uniform vec2 uCentre;
				uniform vec3 uTint;
				uniform vec3 uWhite;
				varying vec3 vN;
				varying vec3 vV;
				void main() {
					vec3 n = normalize(vN);
					float facing = clamp(dot(n, vV), 0.0, 1.0);
					float fres = pow(1.0 - facing, 2.2);
					vec2 uv = gl_FragCoord.xy / uRes;

					// Refraction: the body magnifies what is behind it (a thick lens)
					// and the bevels bend it sharply along their normals.
					vec2 lens = (uCentre - uv) * 0.05;
					vec2 bend = -n.xy * (0.03 + 0.1 * fres);
					vec2 off = lens + bend;

					// Dispersion: red, green and blue bend by different amounts,
					// so edges split into colour like light through a prism.
					float k = 0.05 + 0.5 * fres;
					vec3 col;
					col.r = texture2D(uBg, uv + off * (1.0 - k)).r;
					col.g = texture2D(uBg, uv + off).g;
					col.b = texture2D(uBg, uv + off * (1.0 + k)).b;

					// a faint green body tint and a little extra depth
					col *= mix(vec3(1.0), 0.9 + uTint * 0.2, 0.6); // the faintest green cast

					// studio reflections on top
					vec3 r = reflect(-vV, n);
					float top = smoothstep(0.45, 0.95, r.y);
					float side = smoothstep(0.6, 1.0, r.x) * 0.5;
					float spec = pow(max(dot(r, normalize(vec3(-0.4, 0.7, 0.6))), 0.0), 60.0);
					col += uWhite * (fres * 0.3 + top * 0.12 + side * 0.08 + spec * 0.9);

					// a soft prism fringe right on the rim
					vec3 prism = 0.5 + 0.5 * cos(6.2831 * (fres * 1.3 + vec3(0.0, 0.33, 0.67)));
					col += prism * smoothstep(0.35, 0.9, fres) * 0.18;

					gl_FragColor = vec4(col, 1.0);
				}`,
		});

		const insignia = new Group();
		const parts: GroupT[] = [];
		for (const path of svg.paths) {
			const part = new Group();
			for (const shape of SVGLoader.createShapes(path)) {
				const geo = new ExtrudeGeometry(shape, {
					depth: 40,
					bevelEnabled: true,
					bevelThickness: 12,
					bevelSize: 7,
					bevelSegments: 14,
					curveSegments: 6,
				});
				part.add(new Mesh(geo, material));
			}
			parts.push(part);
			insignia.add(part);
		}
		// SVG y points down: flip, then centre the whole mark on the origin.
		insignia.scale.set(1, -1, 1);
		const box = new Box3().setFromObject(insignia);
		const centre = box.getCenter(new Vector3());
		for (const part of parts) part.children.forEach((m) => m.position.sub(new Vector3(centre.x, -centre.y, centre.z)));
		// Each part pivots around its own centre so it can drift and turn independently.
		const partHome = parts.map((part) => {
			const b = new Box3().setFromObject(part);
			const c = b.getCenter(new Vector3());
			part.children.forEach((m) => m.position.sub(new Vector3(c.x, -c.y, 0)));
			part.position.set(c.x, -c.y, 0);
			return part.position.clone();
		});
		const holder = new Group();
		holder.add(insignia);
		scene.add(holder);

		// Layout
		let w = 0, h = 0, baseX = 0, baseY = 0;
		const resize = () => {
			w = innerWidth;
			h = innerHeight;
			renderer.setSize(w, h, false);
			const buf = renderer.getDrawingBufferSize(new Vector2());
			material.uniforms.uRes.value.copy(buf);
			collect();
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			const s = Math.min(w / 1440, h / 900);
			const scale = (mobile ? 0.9 : 1.2) * Math.max(0.55, s);
			holder.scale.setScalar(scale);
			// over the headline, so the glass has words to bend
			baseX = mobile ? 30 : w > 1100 ? -30 : -10;
			baseY = mobile ? -40 : -70;
		};
		resize();
		addEventListener("resize", resize);

		// Scroll progress across the transparent "stage" sections
		const stageEnd = () => {
			const els = document.querySelectorAll<HTMLElement>("[data-glass-stage]");
			const last = els[els.length - 1];
			return last ? last.getBoundingClientRect().bottom + scrollY : innerHeight * 2;
		};
		let end = stageEnd();
		addEventListener("load", () => (end = stageEnd()));
		addEventListener("resize", () => (end = stageEnd()));

		let px = 0, py = 0, tx = 0, ty = 0;
		addEventListener("pointermove", (e) => {
			tx = (e.clientX / innerWidth) * 2 - 1;
			ty = (e.clientY / innerHeight) * 2 - 1;
		}, { passive: true });

		let visible = true;
		document.addEventListener("visibilitychange", () => (visible = !document.hidden));

		const t0 = performance.now();
		let smooth = 0;
		const frame = () => {
			requestAnimationFrame(frame);
			const y = scrollY;
			const active = y < end;
			root.classList.toggle("is-gone", !active);
			if (!visible || !active) return;

			const t = (performance.now() - t0) / 1000;
			const p = Math.min(1, Math.max(0, y / Math.max(1, end - innerHeight)));
			smooth += (p - smooth) * 0.08;
			px += (tx - px) * 0.05;
			py += (ty - py) * 0.05;

			// whole mark: float, slow turn, pointer tilt
			holder.position.x = baseX;
			holder.position.y = baseY + Math.sin(t * 0.6) * 14 - smooth * 120;
			holder.rotation.x = 0.18 + py * 0.18 + smooth * 0.6;
			holder.rotation.y = -0.35 + Math.sin(t * 0.25) * 0.12 + px * 0.3 + smooth * 0.9;
			holder.rotation.z = -0.06 + smooth * 0.2;

			// parts: open up, then fly out of frame in opposite directions
			const open = Math.min(1, smooth * 1.6);
			const out = Math.max(0, (smooth - 0.35) / 0.65);
			const e = out * out * (3 - 2 * out);
			parts.forEach((part, i) => {
				const dir = i === 0 ? -1 : 1;
				const home = partHome[i];
				part.position.set(
					home.x + dir * (open * 70 + e * 900),
					home.y - dir * (open * 70 + e * 650),
					dir * (open * 60 + e * 300),
				);
				part.rotation.set(dir * e * 1.2, dir * (open * 0.35 + e * 1.4), dir * e * 0.8);
			});


			// repaint what is behind the glass when the page moved or every ~1/4 s
			const now = performance.now();
			if (y !== paintedY || now - paintedAt > 250) {
				paint();
				paintedY = y;
				paintedAt = now;
			}
			const c = holder.position.clone().project(camera);
			material.uniforms.uCentre.value.set(c.x * 0.5 + 0.5, c.y * 0.5 + 0.5);

			renderer.render(scene, camera);
		};
		let paintedY = -1;
		let paintedAt = 0;
		root.classList.add("is-live");
		requestAnimationFrame(frame);
	};

	// Load the 3D library only after the page has finished loading and the
	// browser is idle, so it never delays the first paint or the headline.
	const later = () =>
		"requestIdleCallback" in window ? requestIdleCallback(() => start(), { timeout: 2500 }) : setTimeout(start, 600);
	if (document.readyState === "complete") later();
	else addEventListener("load", later, { once: true });
</script>

<style>
	.glass {
		position: fixed;
		inset: 0;
		z-index: 5; /* over the page content (below the header), never catches clicks */
		pointer-events: none;
	}

	.glass__canvas {
		width: 100%;
		height: 100%;
		display: block;
		opacity: 0;
		transition: opacity 1.4s var(--sc-ease);
	}

	.glass.is-live .glass__canvas {
		opacity: 1;
	}

	.glass__fallback {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		width: min(38vw, 320px);
		height: auto;
		translate: -50% -40%;
		opacity: 0.35;
	}

	.glass.is-live .glass__fallback {
		display: none;
	}

	.glass.is-gone {
		visibility: hidden;
	}
</style>

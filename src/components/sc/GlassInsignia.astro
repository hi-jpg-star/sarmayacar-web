---
/**
 * Frosted-glass 3D Sarmayacar insignia (three.js), fixed behind the top of the
 * home page. Its two interlocking parts float, follow the pointer slightly,
 * and separate and leave the frame as the visitor scrolls.
 *
 * The scene paints the Dark Green background itself; sections that should
 * show it are transparent (see .has-glass rules in ScHero / ScManifesto).
 * Without WebGL or with reduced motion, a still insignia image is shown.
 */
import insigniaRaw from "../../assets/brand/insignia.svg?raw";
import insigniaUrl from "../../assets/brand/insignia.svg?url";
---

<div class="glass" aria-hidden="true" data-glass>
	<canvas class="glass__canvas"></canvas>
	<img class="glass__fallback" src={insigniaUrl} alt="" width="280" height="280" />
	<template data-svg set:html={insigniaRaw} />
</div>

<script>
	import {
		ACESFilmicToneMapping,
		CanvasTexture,
		Color,
		ExtrudeGeometry,
		Group,
		Mesh,
		MeshBasicMaterial,
		MeshPhysicalMaterial,
		PerspectiveCamera,
		PlaneGeometry,
		PMREMGenerator,
		Scene,
		SRGBColorSpace,
		WebGLRenderer,
		Box3,
		Vector3,
	} from "three";
	import { SVGLoader } from "three/examples/jsm/loaders/SVGLoader.js";
	import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";

	const root = document.querySelector<HTMLElement>("[data-glass]");
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

	function webglOk() {
		try {
			const c = document.createElement("canvas");
			return !!(c.getContext("webgl2") || c.getContext("webgl"));
		} catch {
			return false;
		}
	}

	if (root && !reduce && webglOk()) {
		const css = getComputedStyle(document.documentElement);
		const brand = (name: string) => new Color(css.getPropertyValue(name).trim());
		const darkGreen = brand("--sc-dark-green");
		const lightGreen = brand("--sc-light-green");
		const white = brand("--sc-white");

		const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
		const renderer = new WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance" });
		const mobile = matchMedia("(max-width: 760px)").matches;
		renderer.setPixelRatio(Math.min(devicePixelRatio, mobile ? 1.5 : 1.75));
		renderer.outputColorSpace = SRGBColorSpace;
		renderer.toneMapping = ACESFilmicToneMapping;
		renderer.toneMappingExposure = 1.35;
		renderer.setClearColor(darkGreen, 1);

		const scene = new Scene();
		const pmrem = new PMREMGenerator(renderer);
		scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

		const camera = new PerspectiveCamera(30, 1, 1, 5000);
		camera.position.set(0, 0, 1100);

		// One solid backdrop with soft light painted in. Glass (transmission) only
		// refracts opaque objects, so the light has to live on an opaque surface.
		const backdropCanvas = document.createElement("canvas");
		backdropCanvas.width = 1600;
		backdropCanvas.height = 1000;
		const bg = backdropCanvas.getContext("2d")!;
		const hex = (c: Color) => `#${c.getHexString()}`;
		const paintBackdrop = (t: number) => {
			bg.fillStyle = hex(darkGreen);
			bg.fillRect(0, 0, 1600, 1000);
			const blob = (x: number, y: number, r: number, color: Color, a: number) => {
				const g = bg.createRadialGradient(x, y, 0, x, y, r);
				// brand colour (from the CSS variables) + an alpha byte, as 8-digit hex
				const alpha = (v: number) => Math.round(v * 255).toString(16).padStart(2, "0");
				g.addColorStop(0, hex(color) + alpha(a));
				g.addColorStop(1, hex(color) + alpha(0));
				bg.fillStyle = g;
				bg.fillRect(0, 0, 1600, 1000);
			};
			blob(980 + Math.sin(t * 0.3) * 60, 430 + Math.cos(t * 0.25) * 40, 520, lightGreen, 0.95);
			blob(1180 + Math.cos(t * 0.2) * 80, 300, 260, white, 0.55);
			blob(640, 760 + Math.sin(t * 0.22) * 50, 420, lightGreen, 0.5);
			blob(1350, 820, 300, white, 0.18);
		};
		paintBackdrop(0);
		const backdropTexture = new CanvasTexture(backdropCanvas);
		backdropTexture.colorSpace = SRGBColorSpace;
		const backdrop = new Mesh(new PlaneGeometry(1, 1), new MeshBasicMaterial({ map: backdropTexture, toneMapped: false }));
		backdrop.position.z = -700;
		scene.add(backdrop);

		// Extrude the two insignia shapes from the real logo file.
		const tpl = root.querySelector<HTMLTemplateElement>("template[data-svg]")!;
		const svg = new SVGLoader().parse(tpl.innerHTML);
		const material = new MeshPhysicalMaterial({
			color: lightGreen.clone().lerp(white, 0.82),
			metalness: 0,
			roughness: 0.22, // frosted
			transmission: 1,
			thickness: 24,
			ior: 1.5,
			attenuationColor: lightGreen.clone().lerp(white, 0.5),
			attenuationDistance: 1400,
			clearcoat: 1,
			clearcoatRoughness: 0.12,
			specularIntensity: 1,
			envMapIntensity: 1.8,
		});

		const insignia = new Group();
		const parts: Group[] = [];
		for (const path of svg.paths) {
			const part = new Group();
			for (const shape of SVGLoader.createShapes(path)) {
				const geo = new ExtrudeGeometry(shape, {
					depth: 46,
					bevelEnabled: true,
					bevelThickness: 6,
					bevelSize: 4,
					bevelSegments: 6,
					curveSegments: 4,
				});
				part.add(new Mesh(geo, material));
			}
			parts.push(part);
			insignia.add(part);
		}
		// SVG y points down: flip, then centre the whole mark on the origin.
		insignia.scale.set(1, -1, 1);
		const box = new Box3().setFromObject(insignia);
		const centre = box.getCenter(new Vector3());
		for (const part of parts) part.children.forEach((m) => m.position.sub(new Vector3(centre.x, -centre.y, centre.z)));
		// Each part pivots around its own centre so it can drift and turn independently.
		const partHome = parts.map((part) => {
			const b = new Box3().setFromObject(part);
			const c = b.getCenter(new Vector3());
			part.children.forEach((m) => m.position.sub(new Vector3(c.x, -c.y, 0)));
			part.position.set(c.x, -c.y, 0);
			return part.position.clone();
		});
		const holder = new Group();
		holder.add(insignia);
		scene.add(holder);

		// Layout
		let w = 0, h = 0, baseX = 0, baseY = 0;
		const resize = () => {
			w = innerWidth;
			h = innerHeight;
			renderer.setSize(w, h, false);
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			// size the backdrop to fill the view at its depth
			const dist = camera.position.z - backdrop.position.z;
			const vh = 2 * Math.tan((camera.fov * Math.PI) / 360) * dist;
			backdrop.scale.set(vh * camera.aspect * 1.05, vh * 1.05, 1);
			const s = Math.min(w / 1440, h / 900);
			const scale = (mobile ? 0.8 : 0.95) * Math.max(0.55, s);
			holder.scale.setScalar(scale);
			baseX = mobile ? 40 : w > 1100 ? 150 : 90;
			baseY = mobile ? 70 : 30;
		};
		resize();
		addEventListener("resize", resize);

		// Scroll progress across the transparent "stage" sections
		const stageEnd = () => {
			const els = document.querySelectorAll<HTMLElement>("[data-glass-stage]");
			const last = els[els.length - 1];
			return last ? last.getBoundingClientRect().bottom + scrollY : innerHeight * 2;
		};
		let end = stageEnd();
		addEventListener("load", () => (end = stageEnd()));
		addEventListener("resize", () => (end = stageEnd()));

		let px = 0, py = 0, tx = 0, ty = 0;
		addEventListener("pointermove", (e) => {
			tx = (e.clientX / innerWidth) * 2 - 1;
			ty = (e.clientY / innerHeight) * 2 - 1;
		}, { passive: true });

		let visible = true;
		document.addEventListener("visibilitychange", () => (visible = !document.hidden));

		const t0 = performance.now();
		let smooth = 0;
		let lastPaint = -1;
		const frame = () => {
			requestAnimationFrame(frame);
			const y = scrollY;
			const active = y < end;
			root.classList.toggle("is-gone", !active);
			if (!visible || !active) return;

			const t = (performance.now() - t0) / 1000;
			const p = Math.min(1, Math.max(0, y / Math.max(1, end - innerHeight)));
			smooth += (p - smooth) * 0.08;
			px += (tx - px) * 0.05;
			py += (ty - py) * 0.05;

			// whole mark: float, slow turn, pointer tilt
			holder.position.x = baseX;
			holder.position.y = baseY + Math.sin(t * 0.6) * 14 - smooth * 120;
			holder.rotation.x = 0.18 + py * 0.18 + smooth * 0.6;
			holder.rotation.y = -0.35 + Math.sin(t * 0.25) * 0.12 + px * 0.3 + smooth * 0.9;
			holder.rotation.z = -0.06 + smooth * 0.2;

			// parts: open up, then fly out of frame in opposite directions
			const open = Math.min(1, smooth * 1.6);
			const out = Math.max(0, (smooth - 0.35) / 0.65);
			const e = out * out * (3 - 2 * out);
			parts.forEach((part, i) => {
				const dir = i === 0 ? -1 : 1;
				const home = partHome[i];
				part.position.set(
					home.x + dir * (open * 70 + e * 900),
					home.y - dir * (open * 70 + e * 650),
					dir * (open * 60 + e * 300),
				);
				part.rotation.set(dir * e * 1.2, dir * (open * 0.35 + e * 1.4), dir * e * 0.8);
			});

			// slow drift of the light; repaint ~15 times a second
			if (Math.floor(t * 15) !== lastPaint) {
				lastPaint = Math.floor(t * 15);
				paintBackdrop(t);
				backdropTexture.needsUpdate = true;
			}

			renderer.render(scene, camera);
		};
		root.classList.add("is-live");
		requestAnimationFrame(frame);
	}
</script>

<style>
	.glass {
		position: fixed;
		inset: 0;
		z-index: -1;
		background: var(--sc-dark-green);
		pointer-events: none;
	}

	.glass__canvas {
		width: 100%;
		height: 100%;
		display: block;
		opacity: 0;
		transition: opacity 1.4s var(--sc-ease);
	}

	.glass.is-live .glass__canvas {
		opacity: 1;
	}

	.glass__fallback {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		width: min(38vw, 320px);
		height: auto;
		translate: -50% -40%;
		opacity: 0.35;
	}

	.glass.is-live .glass__fallback {
		display: none;
	}

	.glass.is-gone {
		visibility: hidden;
	}
</style>

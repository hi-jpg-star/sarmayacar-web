---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { words } from "../../utils/sc";

type Block = Extract<PageContentBlock, { _type: "sc_manifesto" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
const w = words(value.text);
---

<section class="mf tone-dark" data-tone="dark" id={value.anchor_id || undefined} data-manifesto data-glass-stage>
	<div class="mf__inner sc-container">
		{value.label && <p class="sc-label sc-label--rule mf__label">{value.label}</p>}
		<p class="mf__text" aria-label={value.text}>
			{w.map((word, i) => <span class="mf__w" style={`--i:${i}`} aria-hidden="true">{word} </span>)}
		</p>
	</div>
</section>

<script>
	// Words light up one by one as the statement scrolls through the viewport.
	const blocks = document.querySelectorAll<HTMLElement>("[data-manifesto]");
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
	for (const block of blocks) {
		const ws = [...block.querySelectorAll<HTMLElement>(".mf__w")];
		if (reduce) {
			ws.forEach((w) => w.classList.add("is-lit"));
			continue;
		}
		const tick = () => {
			const r = block.getBoundingClientRect();
			const vh = innerHeight;
			// 0 when the top enters at 85% of the viewport, 1 when the bottom reaches 45%.
			const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.4)));
			const lit = Math.round(p * ws.length * 1.08);
			ws.forEach((w, i) => w.classList.toggle("is-lit", i < lit));
		};
		let raf = 0;
		addEventListener("scroll", () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(tick);
		}, { passive: true });
		tick();
	}
</script>

<style>
	.mf {
		padding-block: clamp(120px, 16vw, 240px);
	}

	:global(body:has(.glass)) .mf {
		background: transparent;
		min-height: 140svh;
		display: grid;
		align-items: center;
	}

	.mf__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		gap: 40px;
		align-items: start;
	}

	.mf__label {
		position: sticky;
		inset-block-start: calc(var(--sc-header-h) + 24px);
		color: var(--sc-mid-grey);
	}

	.mf__text {
		font-size: clamp(30px, 4.4vw, 68px);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.mf__w {
		color: rgb(255 255 255 / 0.16);
		transition: color 0.5s var(--sc-ease);
	}

	.mf__w.is-lit {
		color: var(--sc-white);
	}

	html:not(.js) .mf__w {
		color: var(--sc-white);
	}

	@media (max-width: 800px) {
		.mf__inner {
			grid-template-columns: 1fr;
		}

		.mf__label {
			position: static;
		}
	}
</style>

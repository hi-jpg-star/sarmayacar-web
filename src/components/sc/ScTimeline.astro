---
import { getEmDashCollection } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { monthYear } from "../../utils/sc";

type Block = Extract<PageContentBlock, { _type: "sc_timeline" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
const { entries, cacheHint } = await getEmDashCollection("milestones", { orderBy: { happened_on: "asc" }, limit: 100 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<section class="tl tone-dark sc-columns" data-tone="dark" id={value.anchor_id || undefined} data-timeline>
	<div class="sc-container tl__head">
		<h2 class="sc-h2" data-reveal>{value.headline}</h2>
		<div class="tl__nav">
			<button type="button" class="tl__btn" data-dir="-1" aria-label="Earlier">←</button>
			<button type="button" class="tl__btn" data-dir="1" aria-label="Later">→</button>
		</div>
	</div>
	<div class="tl__rail" tabindex="0" aria-label="Timeline">
		<ol class="tl__list">
			{
				entries.map((m, i) => {
					const d = monthYear(m.data.happened_on);
					return (
						<li class="tl__item" data-reveal style={`--reveal-i:${Math.min(i, 5)}`}>
							<span class="tl__dot" aria-hidden="true" />
							{d && (
								<span class="tl__date">
									<span class="tl__month">{d.month}</span>
									<span class="tl__year">{d.year}</span>
								</span>
							)}
							<span class="tl__text">{m.data.title}</span>
						</li>
					);
				})
			}
		</ol>
	</div>
	<div class="sc-container"><div class="tl__progress"><span></span></div></div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-timeline]")) {
		const rail = root.querySelector<HTMLElement>(".tl__rail")!;
		const bar = root.querySelector<HTMLElement>(".tl__progress span")!;
		const update = () => {
			const max = rail.scrollWidth - rail.clientWidth;
			bar.style.transform = `scaleX(${max > 0 ? rail.scrollLeft / max : 1})`;
		};
		rail.addEventListener("scroll", update, { passive: true });
		root.querySelectorAll<HTMLButtonElement>(".tl__btn").forEach((b) =>
			b.addEventListener("click", () => rail.scrollBy({ left: Number(b.dataset.dir) * rail.clientWidth * 0.6, behavior: "smooth" })),
		);
		// Drag to scroll with a mouse
		let down = false, startX = 0, startLeft = 0;
		rail.addEventListener("pointerdown", (e) => {
			if (e.pointerType !== "mouse") return;
			down = true;
			startX = e.clientX;
			startLeft = rail.scrollLeft;
			rail.classList.add("is-dragging");
		});
		addEventListener("pointermove", (e) => {
			if (down) rail.scrollLeft = startLeft - (e.clientX - startX);
		});
		addEventListener("pointerup", () => {
			down = false;
			rail.classList.remove("is-dragging");
		});
		update();
	}
</script>

<style>
	.tl {
		padding-block: clamp(96px, 12vw, 160px);
		overflow: hidden;
	}

	.tl__head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		margin-block-end: clamp(48px, 6vw, 88px);
	}

	.tl__head h2 {
		max-width: 18ch;
	}

	.tl__nav {
		display: flex;
		gap: 8px;
	}

	.tl__btn {
		width: 56px;
		height: 56px;
		border: 1px solid var(--sc-line-on-dark);
		background: none;
		color: var(--sc-white);
		font-size: 20px;
		cursor: pointer;
		transition: background 0.3s, color 0.3s;
	}

	.tl__btn:hover {
		background: var(--sc-white);
		color: var(--sc-dark-green);
	}

	.tl__rail {
		overflow-x: auto;
		scrollbar-width: none;
		cursor: grab;
		scroll-snap-type: x proximity;
	}

	.tl__rail::-webkit-scrollbar {
		display: none;
	}

	.tl__rail.is-dragging {
		cursor: grabbing;
		scroll-snap-type: none;
	}

	.tl__list {
		display: flex;
		width: max-content;
		list-style: none;
		padding-inline: max(var(--sc-gutter), (100vw - var(--sc-max)) / 2);
	}

	.tl__item {
		position: relative;
		display: grid;
		align-content: start;
		gap: 20px;
		width: clamp(220px, 22vw, 320px);
		padding-block-start: 40px;
		padding-inline-end: 32px;
		border-block-start: 1px solid var(--sc-line-on-dark);
		scroll-snap-align: start;
		user-select: none;
	}

	.tl__dot {
		position: absolute;
		inset-block-start: -5px;
		inset-inline-start: 0;
		width: 9px;
		height: 9px;
		background: var(--sc-light-green);
	}

	.tl__date {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}

	.tl__month {
		font-size: clamp(48px, 5vw, 80px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.tl__year {
		font-size: 14px;
		color: var(--sc-light-green-75);
	}

	.tl__text {
		font-size: 17px;
		line-height: 1.4;
		color: var(--sc-mid-grey);
		max-width: 22ch;
	}

	.tl__progress {
		height: 1px;
		margin-block-start: 56px;
		background: var(--sc-line-on-dark);
	}

	.tl__progress span {
		display: block;
		height: 100%;
		background: var(--sc-light-green);
		transform-origin: left;
		transform: scaleX(0);
	}
</style>

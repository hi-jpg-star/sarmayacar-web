---
/**
 * Sarmayacar footer: a full-screen black panel that sits underneath the page
 * and is uncovered as the visitor scrolls to the end (the page slides up off
 * it). Closing line and funding button, navigation, contact details (from the
 * "footer_contact" menu) and the full logo set large across the bottom.
 */
import logoLight from "../assets/brand/logo-light.svg?url";
import insignia from "../assets/brand/insignia.svg?url";

interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
	cssClasses?: string | null;
}

interface Props {
	items: MenuItem[];
	contact: MenuItem[];
	siteTitle: string;
	tagline?: string | null;
	linkedin?: string | null;
}

const { items, contact, siteTitle, linkedin } = Astro.props;
const year = new Date().getFullYear();
const isButton = (item: MenuItem) => item.cssClasses?.split(/\s+/).includes("button") ?? false;
const links = items.filter((i) => !isButton(i));
const cta = items.find(isButton);
---

<footer class="sf tone-black" data-tone="dark">
	<div class="sf__inner sc-container">
		<div class="sf__lead">
			<img class="sf__mark" src={insignia} alt="" width="56" height="56" />
			<p class="sf__line">Adding value beyond capital.</p>
			{
				cta && (
					<a href={cta.url} class="sc-btn sf__cta">
						{cta.label}
						<span class="sc-btn__arrow" />
					</a>
				)
			}
		</div>

		<div class="sf__cols">
			<nav aria-label="Footer">
				<p class="sc-label">Explore</p>
				<ul>
					{
						links.map((item) => (
							<li>
								<a href={item.url}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
			{
				contact.length > 0 && (
					<div>
						<p class="sc-label">Contact</p>
						<ul>
							{contact.map((item) => (
								<li>
									<a href={item.url} target={item.url.startsWith("http") ? "_blank" : undefined} rel="noopener">
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			{
				linkedin && (
					<div>
						<p class="sc-label">Follow</p>
						<ul>
							<li>
								<a href={linkedin} target="_blank" rel="noopener">
									LinkedIn
								</a>
							</li>
						</ul>
					</div>
				)
			}
		</div>

		<div class="sf__bottom">
			<a href="/" class="sf__logo" aria-label={`${siteTitle} home`}>
				<img src={logoLight} alt="" width="1392" height="283" />
			</a>
			<div class="sf__legal">
				<p>&copy; {year} {siteTitle}</p>
				<a href="#main" class="sf__top-link">Back to top ↑</a>
			</div>
		</div>
	</div>
</footer>

<style>
	/* The page (main) slides up off the footer: the footer sticks to the bottom
	   of the screen underneath it, and main has a solid background on top. */
	.sf {
		position: sticky;
		bottom: 0;
		z-index: 0;
		min-height: 100svh;
		display: flex;
	}

	.sf__inner {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: clamp(48px, 8vh, 96px);
		width: 100%;
		padding-block: calc(var(--sc-header-h) + clamp(24px, 4vh, 56px)) clamp(20px, 3vh, 32px);
	}

	.sf__mark {
		width: 56px;
		height: 56px;
		margin-block-end: clamp(24px, 4vh, 40px);
	}

	.sf__line {
		max-width: 14ch;
		font-size: clamp(44px, 7vw, 120px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.sf__cta {
		margin-block-start: clamp(28px, 5vh, 48px);
	}

	.sf__cols {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 40px 24px;
	}

	.sf__cols .sc-label {
		color: var(--sc-grey);
	}

	.sf__cols ul {
		list-style: none;
		display: grid;
		gap: 10px;
		margin-block-start: 20px;
		font-size: 16px;
		color: var(--sc-mid-grey);
	}

	.sf__cols a,
	.sf__legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.3s;
	}

	.sf__cols a:hover,
	.sf__top-link:hover {
		color: var(--sc-white);
	}

	/* Full logo across the width: the supplied file, scaled evenly (manual 1.2) */
	.sf__logo {
		display: block;
		width: 100%;
	}

	.sf__logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.sf__legal {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-block-start: clamp(20px, 3vh, 32px);
		padding-block-start: 20px;
		border-block-start: 1px solid var(--sc-line-on-dark);
		font-size: 13px;
		color: var(--sc-grey);
	}

	@media (max-width: 800px) {
		.sf__cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* On short screens the footer is taller than the window; it still slides
	   out from under the page, bottom first. */
</style>

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sarmayacar-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true,
		},
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sarmayacar-site",
			"database_id": "a4577a02-7ae6-43b3-9984-627005752b89",
		},
	],
	// Astro sessions (created by the first deploy). Previews need the id spelled out.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "24c3a6891d71448a91825539913ab8f0",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "sarmayacar-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
